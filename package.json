{
  "name": "block-blowup",
  "version": "0.1.0",
  "private": true,
  "description": "Block Blowup: a mobile-first PWA block puzzle game (personal fork of SSWheatley/block_blast).",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "sim": "tsx scripts/simulate.ts",
    "e2e": "playwright test",
    "sim:update": "tsx scripts/simulate.ts --update",
    "check:prod": "tsx scripts/check-prod-build.ts",
    "icons": "tsx scripts/make-icons.ts",
    "lighthouse": "lhci autorun"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.22.0"
  }
}
